# === Database ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gatherly
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# === Redis (optional — leave blank to skip) ===
REDIS_URL=

# === Auth ===
ACCESS_TOKEN_SECRET=change-me-access-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_EXPIRY=7d

# === Cloudinary ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Meilisearch (optional — leave blank to use MySQL fulltext) ===
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=gatherly_meili_key

# === Google OAuth ===
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# === App ===
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
